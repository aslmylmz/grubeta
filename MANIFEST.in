include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include pyproject.toml
include grubeta/py.typed

recursive-include grubeta *.py
recursive-include tests *.py
recursive-include examples *.py *.ipynb
recursive-include docs *.rst *.py *.md

prune docs/_build
prune .github
global-exclude *.pyc
global-exclude __pycache__
global-exclude *.so
global-exclude .DS_Store
